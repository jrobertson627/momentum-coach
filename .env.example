# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# Both values are safe to ship to the browser; row-level security protects the data.
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
VITE_SUPABASE_PUBLISHABLE_KEY=
